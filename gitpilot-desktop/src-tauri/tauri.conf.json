{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "GitPilot",
	"version": "0.1.3",
	"identifier": "com.aiclub.gitpilot.desktop",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "GitPilot",
				"width": 1100,
				"height": 720,
				"minWidth": 800,
				"minHeight": 500,
				"resizable": true,
				"decorations": false,
				"fullscreen": false,
				"visible": false,
				"backgroundColor": "#0b0d12"
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwOEY2NTc3NDYyNjc2OQpSV1JwWjJKMFYvWUlCblU2YXBTUCtQTEF6aW5jRVNzRXErWS83UklRcWV0UnU1TG1UclRrMU1Fago=",
			"endpoints": []
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": "v1Compatible",
		"targets": [
			"msi",
			"nsis",
			"app",
			"dmg"
		],
		"icon": [
			"icons/icon.png",
			"icons/icon.ico"
		],
		"externalBin": [
			"binaries/gitpilot-rpc"
		],
		"resources": [
			"resources/package.json",
			"resources/plannotator.json",
			"resources/theme/*",
			"resources/export-html/**/*",
			"resources/skills/**/*"
		]
	}
}
